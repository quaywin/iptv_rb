# Anti-hotlink headers for strmfree CDN
REFERER=https://strmfree.st/
ORIGIN=https://strmfree.st
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36

# Cache TTL (seconds) for on-demand playlist generation
CACHE_TTL=60

# Worker settings
CHECK_INTERVAL=300000
TIMEOUT=5000

# Schedule window (hours)
HOURS_BACK=4
HOURS_AHEAD=24
CDN_INCLUDE_OFFLINE=true
CDN_HOURS_AHEAD=72
MAX_CHANNELS_PER_EVENT=4
TIMEZONE=Asia/Ho_Chi_Minh

# Xtream Codes API Authentication
# Default password applied to any provider username (e.g. strm, channel4, dam, 247...)
XTREAM_PASSWORD=iptv
# Optional custom user mappings: format username:password:provider,username2:password2:provider2
# XTREAM_USERS=sports:123456:strm,tv:abcdef:channel4,vip:999999:all

# VOD & Series Configuration (TMDb & Video Resolver Proxy)
TMDB_API_KEY=your_tmdb_api_key_here
VOD_RESOLVER_URL=https://your-proxy-domain.com/scrape-video?url=https%3A%2F%2Fvidnest.fun%2Fmovie%2F{tmdbId}
SERIES_RESOLVER_URL=https://your-proxy-domain.com/scrape-video?url=https%3A%2F%2Fvidnest.fun%2Ftv%2F{tmdbId}%2F{season}%2F{episode}


